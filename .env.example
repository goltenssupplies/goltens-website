# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Canonical site URL — used for metadata, canonical tags, hreflang alternates,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.goltenssupplies.com

# Resend (transactional email) — the /rfq form submits through
# lib/actions/submit-rfq.ts. RESEND_API_KEY is required: without it,
# submissions fail with a clear "not configured" error instead of silently
# pretending to succeed. RFQ_NOTIFICATION_EMAIL is optional — it defaults to
# admin@goltenssupplies.com (lib/site.ts) and only needs to be set to
# override that.
RESEND_API_KEY=
RFQ_NOTIFICATION_EMAIL=
# Optional sender identity. Defaults to Resend's own sandbox address
# (onboarding@resend.dev), which works without domain verification.
RESEND_FROM_EMAIL=

# Analytics — add the measurement ID when analytics is configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
